@model CategoryProductsViewModel

@{
	ViewData["Title"] = "Category Details";
}

@await Html.PartialAsync("_Header", "Category Details")


<table class="table table-hover">
	<thead class="table-light">
			<tr>
				<th>Category</th>
				<th>Product Name</th>
				<th>Price</th>
				<th>Image</th>
				<th>Action</th>
			</tr>
	</thead>
	<tbody class="align-middle text-start">
		@foreach(var product in Model.Products)
		{
			<tr>
				<td>@Model.CategoryName</td>
				<td>@product.ProductName</td>
				<td>@product.ProductPrice</td>
				<td>
					<img src="~/images/@product.ImageUrl"
						 class="rounded"
						 alt="@product.ProductName"
						 style="width: 150px; height: 150px; object-fit:cover" />
				</td>
				<td>
					<a asp-controller="Product" asp-action ="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary">
						Details
					</a>
				</td>
			</tr>
		}
			
	</tbody>
</table>

<div class="text-center m-4">
	<button type="button" onclick="history.back()" class="btn btn-outline-secondary">
		Back
	</button>
</div>