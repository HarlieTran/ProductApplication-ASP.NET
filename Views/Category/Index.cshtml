@model List<Category>

@await Html.PartialAsync("_Header", "Category List")

@if(ViewBag.msg != null)
{
	<div class="alert alert-info" role="alert">
		@ViewBag.msg
	</div>
}

<div class="text-end m-4">
	<a asp-action="Create" class="btn btn-outline-secondary">
		Add New Category
	</a>
</div>

<table class="table table-hover">
	<thead class="table-light">
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Description</th>
			<th>Action</th>
		</tr>
	</thead>

	<tbody>
			@foreach (var category in Model)
			{
				<tr>
					<td>@category.Id</td>
					<td>@category.CategoryName</td>
					<td>@category.Description</td>
					<td class="d-grid gap-2 d-md-block">
						<a asp-action="Details" asp-route-id="@category.Id" class="btn btn-outline-secondary btn-sm">
							Details
						</a>
						<a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-warning btn-sm">
							Edit
						</a>
						<a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger btn-sm">
							Delete
						</a>
					</td>
				</tr>
			}
	</tbody>
</table>



