@model ProductCreateViewModel

@{
    ViewData["Title"] = "Add Product";
}

@await Html.PartialAsync("_Header", "Add Product")

@if (ViewBag.msg != null)
{
    <div class="alert alert-info" role="alert">
        @ViewBag.msg
    </div>
}

<div class="d-flex justify-content-center">
    <div class="card mb-3 p-3 shadow-sm rounded h-auto" style="width: 60%">
        <form asp-action="SaveCreate" method="post" class="mt-4">

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label"></label>
                <input asp-for="ProductName" class="form-control" />
                

            </div>

            <div class="mb-3">
                <label asp-for="ProductPrice" class="form-label"></label>
                <input asp-for="ProductPrice" class="form-control" />
                


            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" />

            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />

            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId"  class="form-select">
                    <option value="" disabled selected>Select Category</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.CategoryName</option>
                    }
                </select>
                
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-outline-secondary">Add Product</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back</a>
            </div>
        </form>
    </div>
</div>
