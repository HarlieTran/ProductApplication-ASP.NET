@model List<ProductListViewModel>

@{
	ViewData["Title"] = "Product List";
}

@await Html.PartialAsync("_Header", "Product List")

@if (ViewBag.msg != null)
{
	<div class="alert alert-info" role="alert">
		@ViewBag.msg
	</div>
}

<div class="text-end m-4">
	<a asp-action="Create" class="btn btn-outline-secondary">
		Add New Product
	</a>
</div>

<table class="table table-hover">
	<thead class="table-light">
		<tr>
			<th>Product ID</th>
			<th>Name</th>
			<th>Price</th>
			<th>Image</th>
			<th>Category</th>
			<th>Action</th>
		</tr>
	</thead>

	<tbody class="align-middle text-start">
	@foreach(var product in Model)
	{
		<tr>
			<td>@product.Id</td>
			<td>@product.ProductName</td>
			<td>@product.ProductPrice.ToString("C")</td>
			<td>
				<img src="~/images/@product.ImageUrl" 
					class="rounded" 
					alt="@product.ProductName" 
					style="width: 150px; height: 150px; object-fit:cover"/>
			</td>

			<td>@product.CategoryName</td>

			<td class="align-middle">
				<div class="d-flex flex-column gap-2">
					<a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary">
						Details
					</a>

					<a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-warning">
						Edit
					</a>

					<a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger">
						Delete
					</a>
				</div>
			</td>
		</tr>
	}
	</tbody>
</table>

