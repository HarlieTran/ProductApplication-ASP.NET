@model List<Product>
    <figure class="text-center">
        <blockquote class="blockquote">
            <h1 class="display-5">Product List</h1>
        </blockquote>
        <figcaption class="blockquote-footer">
            Assignment: Build an ASP.NET Core MVC Product Catalog.
        </figcaption>
    </figure>

	<table class="table table-hover">
		<thead class="table-light">
			<tr>
			<td>Product ID</td>
			<td>Name</td>
			<td>Price</td>
			<td>Image</td>
			<td>Action</td>
			</tr>
		</thead>

		<tbody class="align-middle text-start">
		@foreach(var product in Model)
		{
			<tr>
				<td>@product.Id</td>
				<td>@product.ProductName</td>
				<td>@product.ProductPrice</td>
				<td>
					<img src="~/images/@product.ImageUrl" 
						class="rounded" 
						alt="@product.ProductName" 
						style="width: 150px; height: 150px; object-fit:cover"/>
				</td>
				<td>
					<form asp-controller="Product" asp-action="ProductDetail" method="get">
						<input type="hidden" name="id" value="@product.Id" />
						<button type="submit" class="btn btn-outline-secondary">Detail</button>
					</form>
					
				</td>
			</tr>
		}
		</tbody>
	</table>